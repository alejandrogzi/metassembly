/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    xasm — single unified Nextflow configuration

    Infrastructure configuration — do not edit for normal runs.
    Scientific parameters (genome paths, alignment settings) live in params.json.

    Usage:
      nextflow run main.nf -params-file params.json -profile apptainer,slurm

    This file contains:
      1. params {}          — output dir, resource ceilings, nf-core boilerplate
      2. Process resources  — compute tiers (cpus, memory, time) via withLabel
      3. Per-step config    — container, conda, publishDir via withName
      4. Profiles           — executor and environment selection
      5. Reporting          — timeline, trace, DAG
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

cleanup = false
workDir = 'work'

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    MANIFEST
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/


manifest {
    name            = 'hillerlab/xasm'
    author          = 'Alejandro Gonzales-Irribarren, Michael Hiller'
    homePage        = 'https://github.com/hillerlab/xasm'
    description     = "meta-assemble bulk RNA-seq datasets at scale"
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=24.10.5'
    version         = '0.1.0'
}

validation {
    help {
        enabled = true
        command = "nextflow run main.nf -profile <docker/singularity/.../institute>"
        fullParameter = "help_full"
        showHiddenParameter = "show_hidden"
    }
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    DEFAULT PARAMETER VALUES
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Global default params, used in configs
params {

    // Main input options
    input_dir         =  ''         // input directory containing fastq files
    output_dir        =  null       // output directory
    genome            =  ''         // path to genome file (fasta/2bit)
    annotation        =  ''         // path to annotation file (gtf/gff/bed) [defines STAR + iso-orphan inputs]
    splice_scores_dir = null     // path to splicing scores dir
    repeats           = null               // path to repeats.{bed}
    prefix            = null               // prefix for output files
    from              = null               // checkpoint [options: polish, bigbed]
    polish_path       = null               // metassembly used by the polish checkpoint
    all_bed_path      = null               // BED directory used by the bigbed checkpoint

    env =  null       // path to environment dir [optional]

    // Linting
    fq_skip_linting_at_start         = false                      // skip linting
    fq_skip_linting_after_trimming   = true                      // skip linting after trimming
    fq_skip_linting_after_deacon     = true                      // skip linting after decontamination
    fq_extra_args                    = '--disable-validator P001' // forces same name for pair

    // Trimming
    fastp_allow_gap_overlap_trimming    = true  // --allow_gap_overlap_trimming
    fastp_allow_correction              = true  // --correction
    fastp_discard_trimmed_pass          = false // --discard_trimmed_pass
    fastp_save_trimmed_fail             = false // --save_trimmed_fail
    fastp_save_merged                   = false // --save_merged
    fastp_min_trimmed_reads             = 10000 // --min_trimmed_reads
    fastp_deduplicate_reads             = true  // --deduplicate_reads
    fastp_deduplication_accuracy        = 3     // --deduplication_accuracy

    // Decontamination
    deacon_index_path                           = null   // path to deacon index
    deacon_download_index                       = false  // download deacon index
    deacon_make_single_index                    = false  // make single deacon index
    deacon_single_index_use_background          = false  // use background [FDA-ARGOS + RefSeq viral] for single index
    deacon_multi_index_additional_genome_paths  = null   // additional genome paths
    deacon_keep_fastp_fastq                     = false  // keep fastp fastq
    deacon_entropy_threshold                    = 0.5   // deacon entropy threshold -> note background is always 0.5 [0.0 available on zenodo too]
    deacon_background_download_url              = 'https://zenodo.org/records/17511655/files/argos988_rsvirus17900.k31w15e5.idx?download=1'   // deacon background download url

    // CBQ / BINSEQ [optional]
    bqtools_encode_fastqs            = false // encode fastq inputs to .cbq up front; QC then runs via bqc (implies --aligner ruSTAR)
    bqtools_encode_before_alignment  = false // keep fastp+deacon on fastq and encode to .cbq only for the aligner (implies --aligner ruSTAR)
    bqc_min_length                   = 15    // --min-length: reject reads shorter than this
    bqc_quality_tail                 = 15    // --quality-tail: drop 3' bases until the trailing window reaches this Phred
    bqc_poly_g                       = true  // --poly-g: trim G-rich 3' tails
    bqc_max_n                        = null  // --max-n: reject reads with more than N ambiguous bases
    bqc_adapter_auto_detect          = false // --auto-detect: infer adapters. WARN: aborts the task when detection is ambiguous (e.g. pooled libraries)
    bqc_adapter_r1                   = null  // --adapter-r1: explicit R1 adapter sequence
    bqc_adapter_r2                   = null  // --adapter-r2: explicit R2 adapter sequence
    bqc_extra_args                   = null  // extra arguments passed verbatim to `bqc workflow`

    // Alignment
    aligner                                   = "STAR"     // aligner [options: STAR, ruSTAR]; ruSTAR reads fastq and cbq, STAR only fastq
    star_index_path                           = null       // path to STAR index
    star_ignore_gtf_for_index                 = false      // ignores gtf for index
    star_ignore_gtf_for_mapping               = true       // ignores gtf for mapping
    star_seq_center                           = "custom"   // sequencing center
    star_seq_platform                         = "illumina" // sequencing platform
    star_seq_library                          = "default"  // sequencing library
    star_machine_type                         = "default"  // sequencing machine
    star_min_mapped_reads                     = 5          // min mapped reads
    star_extra_align_args                     = null       // extra arguments for STAR
    star_save_unaligned                       = false      // saves unaligned reads
    star_keep_first_pass_bam                  = false      // keep first pass bam
    star_delete_fastq_after_alignment         = true       // delete fastq after second pass
    star_twopass_junctions_file               = null       // path to pre-curated junction file [STAR sjdb 4-col] -> skips first pass
    star_make_coverage                        = true       // make coverage [bedgraph -> bigwig -> wig]

    // Junctions
    junction_min_read_coverage     = 2          // min read support for junction
    junction_min_junction_length   = 50         // min junction length

    // Coverage
    bigtools_keep_bedgraph         = false      // keep bedgraph
    wigtools_keep_bigwig           = false      // keep bigwig
    wigtobigwig_keep_wig           = false      // keep wig

    // Assembly
    skip_assembly                     = false      // skip assembly
    assembly_by_chr                   = true       // split bams per-chr and assemble per-chr [bamsplit chrom + per-chr beaver]
    assembly_exclude_chromosomes      = []         // optional chromosomes to retain in alignment but omit from assembly fan-out
    transmeta_use_annotation          = true       // pass the reference GTF to TransMeta's annotation-guided merge
    assembler                        = "aletsch"  // local assembler [options: aletsch, stringtie3]
    metassembler                     = "beaver"   // meta-assembler [options: beaver, transmeta]
    aletsch_keep_bam                  = false      // keep bam
    aletsch_fallback_insert_size      = null       // replace a zero profiled insert-size mean when explicitly provided
    aletsch_fallback_insert_std       = 10         // standard deviation paired with the optional fallback mean
    beaver_keep_aletsch_gtf           = false      // keep aletsch gtf

    // Stringtie3 options
    stringtie3_enable_nascent_assembly = false     // stringtie3: run de novo assembly of nascent RNA [-N]
    stringtie3_include_nascent_rna     = false     // stringtie3: include nascent RNA in the assembly [--nasc]

    // xloci options [intron]
    xloci_upstream_flank = 100    // upstream flank [ default: 100 ]
    xloci_downstream_flank = 100  // downstream flank [ default: 100 ]

    // Isotools intron classifier options
    isotools_classify_spliceai_min_ss_signal     = 0.02 // min signal to be considered significant [ default: 0.02 ]
    isotools_classify_rt_frequency_threshold     = 0.5  // frequency threshold to be considered [ default: 0.5 ]
    isotools_classify_intron_frequency_threshold = 0.5  // frequency threshold to be considered [ default: 0.5 ]
    isotools_classify_maxent_min_ss_signal       = 1.5  // frequency threshold to be considered [ default: 0.5 ]
    do_twopass_polish                            = false // review first-pass retention discards and rescue UTR retentions

    // Bigbed options
    autosql = null
    skip_bb_conversion = false

    // Mailing options
    sent_email                   = false             // decides to send email or not
    smtp_server                  = 'smtp.gmail.com'  // smtp server [default: smtp.gmail.com]
    smtp_port                    = 465               // smtp port [default: 465]
    smtp_user                    = null              // smtp user [sender]
    smtp_password                = null              // smtp password [sender]
    smtp_security                = 'ssl'             // smtp security [none, tls, ssl]
    email_to                     = null              // recipient email address
    email_on_fail                = null              // email_on_fail
    plaintext_email              = false             // plaintext_email
    interactive                  = false             // interactive
    use_mailx                    = false             // use_mailx instead smtp

    // Boilerplate options
    publish_dir_mode             = 'copy'   // publish_dir_mode
    publish_all                  = false    // publish all
    help                         = false    // help
    help_full                    = false    // help_full
    show_hidden                  = false    // show_hidden
    version                      = false    // version
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')  // Config options

    // Config options
    config_profile_name        = null
    config_profile_description = null

}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    EXTENDING PROCESS DEFINITIONS AND ARGUMENTS
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Add params to fastp process
process {
    withName: /.*:FASTP/ {
        ext.args = { [
            params.fastp_allow_gap_overlap_trimming ? '--allow_gap_overlap_trimming' : '',
            params.fastp_allow_correction ? '--correction' : '',
            params.fastp_deduplicate_reads ? '--dedup' : '',
            params.fastp_deduplication_accuracy ? "--dup_calc_accuracy ${params.fastp_deduplication_accuracy}" : ''
        ].findAll { it != '' }.join(' ').trim() }
        ext.prefix = { "${meta.id}" }
    }
}

// Add params to wget deacon index process
process {
    withName: /.*:WGET_DEACON_INDEX/ {
        ext.suffix = { "idx" }
        publishDir = [
            path: { "${params.output_dir}/00_prepare/wget/deacon_index" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: /.*:DEACON_FILTER/ {
        ext.prefix = { "${meta.id}" }
        publishDir = [
             path: { "${params.output_dir}/01_deacon_filter" },
             mode: 'symlink', // WARN: change to params.publish_dir_mode if fastqs needed
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: /.*:DEACON_DIFF/ {
        ext.prefix = { "${meta.id}_filtered" }
        publishDir = [
             path: { "${params.output_dir}/00_prepare/deacon_index" },
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: /.*:WGET_BACKGROUND/ {
        ext.when = true
        ext.suffix = { "idx" }
    }

    withName: /.*:DEACON_INDEX/ {
        ext.when = true
        ext.args = {
          def args = """
            --entropy-threshold ${params.deacon_entropy_threshold}
          """ .trim()

          return args
        }
    }
}

// Params for STAR processes
process {
    // Add params to STAR process
    withName: /.*:STAR_ALIGN_1PASS/ {
        ext.when = true
        ext.args   = {
            def extra_args = params.star_extra_align_args ?: ''
            // Standard STAR-2pass pipeline configuration!
            def base_args = """
                --readFilesCommand zcat
            """.trim()

            return base_args + " " + extra_args
        }
        ext.prefix = { "${meta.id}" }
    }

    // Add params to STAR 2pass process
    withName: /.*:STAR_ALIGN_2PASS/ {
        ext.when = true
        ext.args   = {
            def extra_args = params.star_extra_align_args ?: ''
            // Standard STAR-2pass pipeline configuration!
            def base_args = [
                '--outSAMtype BAM SortedByCoordinate',
                '--outSAMattributes NH HI AS nM NM MD ch',
                '--readFilesCommand zcat',
                '--outSAMstrandField intronMotif',
                '--outSAMunmapped None',
                '--outFilterMultimapNmax 20',
                '--alignSJDBoverhangMin 1',
                '--peOverlapNbasesMin 5',
                '--outBAMcompression 10',
                '--limitSjdbInsertNsj 2500000',
            ]

            if (params.star_make_coverage) {
              base_args = base_args + ' --outWigType bedGraph --outWigStrand Unstranded --outWigNorm RPM'
            }

            return (base_args + extra_args.split(' ')).join(' ')
        }
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.output_dir}/03_star_2pass" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Add params to ruSTAR 1pass process
    withName: /.*:RUSTAR_ALIGN_1PASS/ {
        ext.when = true
        ext.args   = {
            // NOTE: --readFilesCommand is NOT set here. RUSTAR_ALIGN adds `zcat` itself
            // only when the staged file is FASTQ, since a .cbq is decoded in-process.
            return (params.star_extra_align_args ?: '').trim()
        }
        ext.prefix = { "${meta.id}" }
    }

    // Add params to ruSTAR 2pass process
    withName: /.*:RUSTAR_ALIGN_2PASS/ {
        ext.when = true
        ext.args   = {
            def extra_args = params.star_extra_align_args ?: ''
            // Mirrors the STAR 2pass configuration, with two deliberate omissions:
            //   --readFilesCommand   RUSTAR_ALIGN adds `zcat` itself, and only for FASTQ
            //   --limitSjdbInsertNsj not implemented by rustar-aligner 0.2.0 (it is a
            //                        STAR-specific sjdb insertion cap) -- passing it aborts
            // Every other flag below is accepted by rustar-aligner.
            def base_args = [
                '--outSAMtype BAM SortedByCoordinate',
                // 'ch' (STAR's chimeric tag) is dropped: rustar-aligner accepts only
                // Standard/All/None or NH HI AS NM nM MD jM jI XS RG vW vA vG.
                '--outSAMattributes NH HI AS nM NM MD',
                '--outSAMstrandField intronMotif',
                '--outSAMunmapped None',
                '--outFilterMultimapNmax 20',
                '--alignSJDBoverhangMin 1',
                '--peOverlapNbasesMin 5',
                '--outBAMcompression 10',
            ]

            // No coverage args here: rustar-aligner rejects `--outWigStrand Unstranded`
            // and only emits Stranded (str1 + str2), which is not what COVERAGE consumes.
            // validateRun() blocks aligner=ruSTAR together with star_make_coverage.

            // NOTE: guarded, unlike the STAR block above. `''.split(' ')` yields a
            // one-element array that Groovy appends as a single item, emitting a literal
            // "[]" token. STAR ignores it; rustar-aligner aborts on it.
            return (base_args + (extra_args ? extra_args.split(' ') as List : [])).join(' ')
        }
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.output_dir}/03_star_2pass" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ruSTAR delegates BAM indexing here (no samtools in the aligner image)
    withName: /.*:SAMTOOLS_INDEX/ {
        ext.prefix = { "${meta.id}" }
    }

    withName: /.*:BQTOOLS_ENCODE_INPUT/ {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.output_dir}/00_prepare/cbq" },
            mode: 'symlink', // WARN: change to params.publish_dir_mode if the .cbq files are needed
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // No publishDir: transient, and it deletes its own fastq input
    withName: /.*:BQTOOLS_ENCODE_ALIGN/ {
        ext.prefix = { "${meta.id}" }
    }

    withName: /.*:BQC/ {
        // NOTE: `bqc workflow` aborts when no operation is configured, so --min-length
        // is always emitted to keep this list non-empty.
        ext.args = {
            [
                "--min-length ${params.bqc_min_length}",
                params.bqc_quality_tail      ? "--quality-tail ${params.bqc_quality_tail}" : '',
                params.bqc_poly_g            ? '--poly-g' : '',
                params.bqc_max_n != null     ? "--max-n ${params.bqc_max_n}" : '',
                params.bqc_adapter_auto_detect ? '--auto-detect' : '',
                params.bqc_adapter_r1        ? "--adapter-r1 ${params.bqc_adapter_r1}" : '',
                params.bqc_adapter_r2        ? "--adapter-r2 ${params.bqc_adapter_r2}" : '',
                params.bqc_extra_args        ?: ''
            ].findAll { it != '' }.join(' ').trim()
        }
        ext.prefix = { "${meta.id}" }
    }

    // Add params to STAR genome generate process [will publish index on default]
    withName: /.*:STAR_GENOMEGENERATE/ {
        ext.when = true
        publishDir = [
            path: { "${params.output_dir}/02_star_index" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}


// Add params to MultiQC process
process {
    withName: /.*:MULTIQC|MULTIQC/ {
        ext.args = { "--flat" }
        publishDir = [
            path: { "${params.output_dir}/0X_multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

// Add params to Stringtie3 process
process {
    withName: /.*:STRINGTIE3/ {
        ext.args = {
          def args = []

          if (params.stringtie3_enable_nascent_assembly) {
            args += "-N"
          } else if (params.stringtie3_include_nascent_rna) {
            args += "--nasc"
          }

          return args.join(' ')
        }
    }
}

// Overwriting publish mode for beaver/transmeta
process {
    withName: /.*:BEAVER/ {
        publishDir = [
            path: { "${params.output_dir}/06_beaver" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.prefix = { params.assembly_by_chr ? (params.prefix ? "${params.prefix}_${meta.chr}" : meta.chr) : params.prefix }
    }

    withName: /.*:TRANSMETA/ {
        publishDir = [
            path: { "${params.output_dir}/06_transmeta" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.prefix = { params.assembly_by_chr ? (params.prefix ? "${params.prefix}_${meta.chr}" : meta.chr) : params.prefix }
    }
}

// Overwriting publish mode for novel junctions
process {
    withName: /.*:JOIN_JUNCTIONS/ {
        publishDir = [
            path: { "${params.output_dir}/04_junctions" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

// Ignoreing errors for bedgraphtobigwig
process {
    withName: /.*:BEDGRAPHTOBIGWIG/ {
        errorStrategy = 'ignore'
    }
}

// Overwriting publish mode for wigtobigwig
process {
    withName: /.*:WIGTOBIGWIG/ {
        publishDir = [
            path: { "${params.output_dir}/05_coverage" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

// Overwriting publish mode for cleaning
process {
    withName: /.*:GTF_REMOVE_DIRT/ {
        publishDir = [
            path: { "${params.output_dir}/07_remove_dirt" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

// Overwriting publish mode for gxf2bed
process {
    withName: /.*:GXF2BED/ {
        publishDir = [
            path: { "${params.output_dir}/08_gxf2bed" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

// Overwriting publish mode for isotools fusion
process {
    withName: /.*:ISOTOOLS_FUSION.*/ {
        publishDir = [
            path: { "${params.output_dir}/09_polish/fusions" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

// Overwriting publish mode for isotools orphans
process {
    withName: /.*:ISOTOOLS_ORPHAN.*/ {
        publishDir = [
            path: { "${params.output_dir}/09_polish" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

process {
    withName: /.*:XLOCI_EXTRACT_INTRONS/ {
        ext.prefix = { "${meta.id}" }
        publishDir = [
             path: { "${params.output_dir}/09_polish/intron_sequences" },
             mode: params.publish_dir_mode,
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = {
            // Standard configuration!
            def args = [ 
              "--upstream-flank ${params.xloci_upstream_flank}",
              "--downstream-flank ${params.xloci_downstream_flank}",
              "--split-extraction",
              "--as-tsv",
              "--add-tab",
              "--generic-id"
            ]

            return args.join(' ')
        }
    }

    withName: /.*:IIC_PREDICT_SPLICEOSOME/ {
        ext.prefix = { "${meta.id}" }
        publishDir = [
             path: { "${params.output_dir}/09_polish/iic" },
             mode: params.publish_dir_mode,
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = {
            // Standard configuration!
            def args = [ 
                "--no-abbreviate"
            ]

            return args.join(' ')
        }
    }

    withName: /.*:ISOTOOLS_CLASSIFY_INTRON/ {
        ext.prefix = { "${meta.id}" }
        publishDir = [
             path: { "${params.output_dir}/09_polish/classify" },
             mode: params.publish_dir_mode,
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = {
            // Standard configuration!
            def args = [ 
              "--scan",
              "--nag",
              "-S ${params.isotools_classify_spliceai_min_ss_signal}",
              "-F ${params.isotools_classify_rt_frequency_threshold}",
              "-f ${params.isotools_classify_intron_frequency_threshold}",
              "-M ${params.isotools_classify_maxent_min_ss_signal}"
            ]

            return args.join(' ')
        }
    }

    withName: /.*:ISOTOOLS_INTRON_RETENTION/ {
        ext.prefix = { "${meta.id}" }
        publishDir = [
             path: { "${params.output_dir}/09_polish/retentions" },
             mode: params.publish_dir_mode,
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: /.*:ISOTOOLS_CLASSIFY_INTRON_TWOPASS/ {
        ext.prefix = { "${meta.id}" }
        publishDir = [
             path: { "${params.output_dir}/09_polish/twopass/classify" },
             mode: params.publish_dir_mode,
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = {
            def args = [
              "--scan",
              "--nag",
              "-S ${params.isotools_classify_spliceai_min_ss_signal}",
              "-F ${params.isotools_classify_rt_frequency_threshold}",
              "-f ${params.isotools_classify_intron_frequency_threshold}",
              "-M ${params.isotools_classify_maxent_min_ss_signal}"
            ]

            return args.join(' ')
        }
    }

    withName: /.*:ISOTOOLS_INTRON_RETENTION_TWOPASS/ {
        ext.prefix = { "${meta.id}" }
        ext.args = '--ignore-utr'
        publishDir = [
             path: { "${params.output_dir}/09_polish/twopass/retentions" },
             mode: params.publish_dir_mode,
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

// Overwriting publish mode for final results
process {
    withName: /.*:STRIP_RETENTIONS/ {
        publishDir = [
            path: { params.do_twopass_polish ? "${params.output_dir}/09_polish/twopass/input_retentions" : "${params.output_dir}/10_final/retentions" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            pattern: '*discard.bed'
        ]
    }


    withName: /.*:STRIP_RETENTIONS_TWOPASS/ {
        publishDir = [
            path: { "${params.output_dir}/10_final/retentions" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            pattern: '*discard.bed'
        ]
    }
}

process {
    withName: /.*:STRIP_STRONG_RTS/ {
        publishDir = [
            path: { "${params.output_dir}/10_final/strong_rts" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            pattern: '*discard.bed'
        ]
    }
}

process {
    withName: /.*:STRIP_WEAK_RTS/ {
        publishDir = [
            path: { "${params.output_dir}/10_final/weak_rts" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            pattern: '*discard.bed'
        ]
    }
}

process {
    withName: /.*:STRIP_ARTIFACTS/ {
        publishDir = [
            path: { "${params.output_dir}/10_final/artifacts" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            pattern: '*discard.bed'
        ]
    }
}

process {
    withName: /.*:PUBLISH_FINAL_TRANSCRIPTS/ {
        publishDir = [
            path: { "${params.output_dir}/10_final" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            pattern: '*.bed'
        ]
    }
}

process {
    withName: '.*:BEDTOBIGBED_HQ|.*:BEDTOBIGBED_FUSIONS|.*:BEDTOBIGBED_ARTIFACTS|.*:BEDTOBIGBED_WEAK_RTS|.*:BEDTOBIGBED_STRONG_RTS|.*:BEDTOBIGBED_RETENTIONS|.*:BEDTOBIGBED_SCRAPS' {
        publishDir = [
            path: { "${params.output_dir}/11_bbs" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            pattern: '*.bb'
        ]
    }
}

process {
    withName: '.*:FROM_BIGBED:.*' {
         publishDir = [
            path: { "${params.output_dir}/11_bbs" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            pattern: '*.bb'
        ]         
    }
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    EXECUTOR/PROFILES CONFIG
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

profiles {
     local {
        process.executor = 'local'
     }

     slurm {
        process {
            executor        = 'slurm'
            queue           = 'batch'
            scratch         = true
            stageInMode     = 'symlink'
            stageOutMode    = 'rsync'
            queue          = { task.time <= 24.h ? 'batch' : 'long' }
            clusterOptions = '--signal=USR2@180 --export=ALL,SLURM_SKIP_EPILOG=1'

            withName: '.*:FASTP|.*:BQC|.*:BQTOOLS_ENCODE.*|.*:DEACON_FILTER|.*:STAR_ALIGN_1PASS|.*:STAR_ALIGN_2PASS|.*:RUSTAR_ALIGN_1PASS|.*:RUSTAR_ALIGN_2PASS|.*:SAMTOOLS_INDEX|.*:BEDGRAPHTOBIGWIG|.*:ALETSCH' {
                array = 50
            }
        }
        executor {
            queueSize         = 10000
            killBatchSize     = 1000000
            pollInterval      = '10 s'      // internal task-monitor tick (no SLURM RPC)
            queueStatInterval = '1 min'     // squeue cadence — halves RPC pressure
            submitRateLimit   = '5000/30sec' // max concurrent submits per node
            exitReadTimeout   = '5 min'    // tolerate slow .exitcode propagation; lets retry fire on ghosts
        }
    }   

    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }

    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }

    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        conda.channels          = ['conda-forge', 'bioconda']
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }

    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
        docker.pullTimeout      = '20 min'
    }

    arm {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }

    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        singularity.pullTimeout = '20 min'
    }

    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        podman.pullTimeout      = '20 min'
    }

    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }

    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }

    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.pullTimeout   = '20 min'
    }

    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }

    gitpod {
        executor.name           = 'local'
        executor.cpus           = 4
        executor.memory         = 8.GB
        process {
            resourceLimits = [
                memory: 8.GB,
                cpus  : 4,
                time  : 1.h
            ]
        }
    }

    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }

     'test-polish' {
        process.resourceLimits = [ cpus: 4, memory: 8.GB, time: 1.h ]
        params.output_dir  = "${projectDir}/test_results"
        params.genome      = "${projectDir}/test_data/test_genome.fa"
        params.annotation  = "${projectDir}/test_data/test_annotation.gtf"
        params.from        = 'polish'
        params.polish_path = "${projectDir}/test_data/test_metassembly.gtf"

        params.prefix = "test"

        params.skip_bb_conversion = true
     }

     test {
        process.resourceLimits = [ cpus: 4, memory: 8.GB, time: 1.h ]
        params.output_dir  = "${projectDir}/test_results/aletsch-beaver"
        params.input_dir   = "${projectDir}/test_data/e2e/reads"
        params.genome      = "${projectDir}/test_data/e2e/genome.2bit"
        params.annotation  = "${projectDir}/test_data/e2e/annotation.gtf"
        params.splice_scores_dir = "${projectDir}/test_data/e2e/spliceai"
        params.repeats     = "${projectDir}/test_data/e2e/repeats.bed"
        params.prefix      = "test"

        params.fastp_min_trimmed_reads = 100
        params.fastp_deduplicate_reads = false
        params.deacon_make_single_index = true
        params.deacon_single_index_use_background = false
        params.star_ignore_gtf_for_index = false
        params.star_ignore_gtf_for_mapping = false
        params.junction_min_read_coverage = 2
        params.junction_min_junction_length = 20
        params.assembly_by_chr = true
        params.assembly_exclude_chromosomes = ['chrTestFlush']
        params.assembler = "aletsch"
        params.metassembler = "beaver"
        params.aletsch_fallback_insert_size = 180
        params.do_twopass_polish = true
        params.skip_bb_conversion = true
     }

     'test-sb' {
        process.resourceLimits = [ cpus: 4, memory: 8.GB, time: 1.h ]
        params.output_dir  = "${projectDir}/test_results/stringtie-beaver"
        params.input_dir   = "${projectDir}/test_data/e2e/reads"
        params.genome      = "${projectDir}/test_data/e2e/genome.2bit"
        params.annotation  = "${projectDir}/test_data/e2e/annotation.gtf"
        params.splice_scores_dir = "${projectDir}/test_data/e2e/spliceai"
        params.repeats     = "${projectDir}/test_data/e2e/repeats.bed"
        params.prefix      = "test_sb"

        params.fastp_min_trimmed_reads = 100
        params.fastp_deduplicate_reads = false
        params.deacon_make_single_index = true
        params.deacon_single_index_use_background = false
        params.star_ignore_gtf_for_index = false
        params.star_ignore_gtf_for_mapping = false
        params.junction_min_read_coverage = 2
        params.junction_min_junction_length = 20
        params.assembly_by_chr = true
        params.assembly_exclude_chromosomes = ['chrTestFlush']
        params.assembler = "stringtie3"
        params.metassembler = "beaver"
        params.skip_bb_conversion = true
     }

     'test-tm' {
        process.resourceLimits = [ cpus: 4, memory: 8.GB, time: 1.h ]
        params.output_dir  = "${projectDir}/test_results/transmeta"
        params.input_dir   = "${projectDir}/test_data/e2e/reads"
        params.genome      = "${projectDir}/test_data/e2e/genome.2bit"
        params.annotation  = "${projectDir}/test_data/e2e/annotation.gtf"
        params.splice_scores_dir = "${projectDir}/test_data/e2e/spliceai"
        params.repeats     = "${projectDir}/test_data/e2e/repeats.bed"
        params.prefix      = "test_tm"

        params.fastp_min_trimmed_reads = 100
        params.fastp_deduplicate_reads = false
        params.deacon_make_single_index = true
        params.deacon_single_index_use_background = false
        params.star_ignore_gtf_for_index = false
        params.star_ignore_gtf_for_mapping = false
        params.junction_min_read_coverage = 2
        params.junction_min_junction_length = 20
        params.assembly_by_chr = true
        params.assembly_exclude_chromosomes = ['chrTestFlush']
        params.metassembler = "transmeta"
        params.transmeta_use_annotation = false
        params.skip_bb_conversion = true
     }

     'test-rustar' {
        process.resourceLimits = [ cpus: 4, memory: 8.GB, time: 1.h ]
        params.output_dir  = "${projectDir}/test_results/rustar-beaver"
        params.input_dir   = "${projectDir}/test_data/e2e/reads"
        params.genome      = "${projectDir}/test_data/e2e/genome.2bit"
        params.annotation  = "${projectDir}/test_data/e2e/annotation.gtf"
        params.splice_scores_dir = "${projectDir}/test_data/e2e/spliceai"
        params.repeats     = "${projectDir}/test_data/e2e/repeats.bed"
        params.prefix      = "test"

        params.fastp_min_trimmed_reads = 100
        params.fastp_deduplicate_reads = false
        params.deacon_make_single_index = true
        params.deacon_single_index_use_background = false
        params.junction_min_read_coverage = 2
        params.junction_min_junction_length = 20
        params.assembly_by_chr = true
        params.assembly_exclude_chromosomes = ['chrTestFlush']
        params.assembler = "aletsch"
        params.metassembler = "beaver"
        params.skip_bb_conversion = true

        params.aligner = "ruSTAR"
        params.star_make_coverage = false
        params.bqtools_encode_fastqs = true
     }
}


/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    PROCESS LABELS;
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    cpus   = { 1      * task.attempt }
    memory = { 6.GB   * task.attempt }
    time   = { 4.h    * task.attempt }

    errorStrategy = {
        (task.exitStatus in ((130..145) + 104 + 175)) ||
        (task.exitStatus in [null, Integer.MAX_VALUE])   ? 'retry' : 'finish'
    }
    maxRetries    = 5
    maxErrors     = '-1'

    // Single processes
    withLabel: process_single {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }

    // Low memory processes
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:custom_process_low {
        cpus   = { 4     * task.attempt }
        memory = { 10.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    // Medium memory processes
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:custom_process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 64.GB * task.attempt }
        time   = { 12.h   * task.attempt }
    }

    // High memory processes
    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 200.GB * task.attempt }
    }

    // Long running processes
    withLabel:process_long {
        time   = { 20.h  * task.attempt }
        queue  = 'long'
    }
    withLabel:process_long_high {
        cpus   = { 24 }
        memory = { 72.GB * task.attempt }
        time   = { 96.h  * task.attempt }
        queue  = 'long'
    }

    // Strategies
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }

    // GPU
    withLabel: process_gpu {
        ext.use_gpu = { workflow.profile.contains('gpu') }
        accelerator = { workflow.profile.contains('gpu') ? 1 : null }
    }
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    REGISTRY CONFIG
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ENVIRONMENT CONFIG
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    BASH OPTIONS
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Set bash options
process {
  shell = [
      "bash",
      "-C",         // No clobber - prevent output redirection from overwriting files.
      "-e",         // Exit if a tool returns a non-zero status/exit code
      "-u",         // Treat unset variables and parameters as an error
      "-o",         // Returns the status of the last command to exit..
      "pipefail"    //   ..with a non-zero status or zero if all successfully execute
  ]
}


/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    REPORT PARAMETER VALUES
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.output_dir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.output_dir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.output_dir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.output_dir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}
